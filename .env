# ============================================================
# NexusTop — environment template
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.
# ============================================================

# ---- Database (REQUIRED) -----------------------------------
# Backend writes go through Drizzle using this connection string. In production
# point this at your Supabase Postgres pooler (it bypasses RLS, so writes work).
DATABASE_URL=postgresql://postgres:G89&NiWn/_95WHP@db.qamfcdycuopfqqmqltjy.supabase.co:5432/postgres

# ---- Session signing (REQUIRED for auth) -------------------
# Random string used to sign auth cookies. Generate one:
#   openssl rand -base64 32
SESSION_SECRET=6hKJHROWl1qfe2GTCpLlSKNBhhPPTSGe5P+niUe6JzE=

# ---- Supabase: frontend READ access (anon key) -------------
# The anon key is PUBLIC and safe to ship in the frontend because Row Level
# Security (supabase/rls.sql) locks it to READ-ONLY on catalog tables.
# It can never insert/update/delete or read private tables.
NEXT_PUBLIC_SUPABASE_URL=https://qamfcdycuopfqqmqltjy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFhbWZjZHljdW9wZnFxbXFsdGp5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI4MTE2NDEsImV4cCI6MjA5ODM4NzY0MX0.4cG-Vm5HW2oqDwmM2QcHc4Y_WXdxPNidTA5iOs1lSlQ

# Optional: used by the Google OAuth redirect route
NEXT_PUBLIC_SITE_URL=https://arduyy.my.id

# ============================================================
# Integration API keys are NOT in env. They live in the database
# (settings table) only — manage them via your separately-hosted admin panel
# or at runtime (admin only):  PUT /api/config/secrets
#
#   OpenRouter, ApiGames, SekaliPay, Midtrans, Resend, Fonnte
#
# The Supabase SERVICE ROLE KEY is also NOT here — this app's reads use the
# anon key and its writes use DATABASE_URL. The service key is only for the
# external admin panel. Set it there, never in the frontend.
# ============================================================
